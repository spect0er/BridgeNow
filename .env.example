# BridgeNow Production Environment Configuration Template

# Server Port
PORT=5000

# JWT Authorization Deployment Settings
# IMPORTANT: Generate a strong random 256-bit secret string for production deployment
JWT_SECRET=super_secret_production_jwt_key_change_me_in_prod_2026
JWT_EXPIRES_IN=7d

# Environment Mode ('development' or 'production')
NODE_ENV=production

# CORS Allowed Origin (Set to your deployed frontend domain in production, e.g. https://bridgenow.com)
CORS_ORIGIN=*

# SQLite Database Location
DB_PATH=./server/database.db

# Frontend Environment Override (Optional, used during Vite build for remote backend)
# VITE_API_URL=https://api.bridgenow.com/api
